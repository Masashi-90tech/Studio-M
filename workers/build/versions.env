# 3D ワーカーの同梱物（workers-pack）の版・入手先・SHA-256。build-pack.sh が読み込む（bash の構文）。手順は docs/WORKERS-BUILD.md。
# SHA-256 が TODO のままだと、ビルドは実際の値を表示してわざと失敗する（desktop/tools/ccx/versions.env と同じ流儀）。

WORKERS_VERSION=0.1.0

# python-build-standalone（Astral）。移動できる CPython。install_only は pip 込みで、場所を動かしても動く形
PBS_TAG=20250902
PBS_PYTHON_VERSION=3.12.11
PBS_BASE_URL="https://github.com/astral-sh/python-build-standalone/releases/download/${PBS_TAG}"
# SHA-256 は、同じリリースの SHA256SUMS（配布元が公開している）に書かれた値。2026-11-27 に取得して書き写した
PBS_MACOS_ARM64_FILE="cpython-${PBS_PYTHON_VERSION}+${PBS_TAG}-aarch64-apple-darwin-install_only.tar.gz"
PBS_MACOS_ARM64_SHA256=9eb6cd7e9ad083cb6eec77bb6e3e9d3426042ed9bcf880c3e1704b1797c1c315
PBS_WINDOWS_X64_FILE="cpython-${PBS_PYTHON_VERSION}+${PBS_TAG}-x86_64-pc-windows-msvc-install_only.tar.gz"
PBS_WINDOWS_X64_SHA256=9ff8fddfd39b518d3902f204ceb9b6cef4213c6d78cf4bc4507c28079afece7c
# Linux は、手元の確認用（build-pack.sh を Linux で動かすとき。WORKERS_PLATFORM=linux-x64）
PBS_LINUX_X64_FILE="cpython-${PBS_PYTHON_VERSION}+${PBS_TAG}-x86_64-unknown-linux-gnu-install_only.tar.gz"
PBS_LINUX_X64_SHA256=59c2827a4385741d04ea3971a3e6a845f951e96b2d168284534cc0d465391eeb

# wheel の版。workers/requirements-shape.txt・requirements-mesh.txt と揃える（build-pack.sh が食い違いを検査する）
OCP_NOVTK_VERSION=8.0.1.1.0
OCP_PROXY_VERSION=8.0.1.1.0
GMSH_VERSION=4.15.2
NUMPY_VERSION=2.5.5
