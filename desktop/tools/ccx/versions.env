# CalculiX と依存ソースの版・入手先・SHA-256。build-macos.sh / build-windows.sh が読み込む（bash の構文）。
# SHA-256 が TODO のままだとビルドはわざと失敗し、実際の値を表示する。確かめた値をここに書き戻すこと。

CCX_VERSION=2.23
# 作者（Guido Dhondt）のサイト。calculix.de の同名 URL は 2026-11-20 に 404 だったので、こちらを主にする
CCX_URL="http://www.dhondt.de/ccx_${CCX_VERSION}.src.tar.bz2"
CCX_URL_FALLBACK="http://www.calculix.de/ccx_${CCX_VERSION}.src.tar.bz2"
# 2026-11-20 に GitHub Actions（macOS・Windows の 2 つのランナー）で取得した値。公式は SHA-256 を公開していないため「初回に取得した値」（以後の改ざん検出用）
CCX_SHA256=9c88385c10fb04f5dc6c4e98027a51bebdd8aee3920e05190d6c1dd08357d6e7

SPOOLES_URL="http://www.netlib.org/linalg/spooles/spooles.2.2.tgz"
