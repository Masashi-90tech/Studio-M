{
  "name": "studio-m",
  "version": "0.1.0",
  "description": "Studio M — DIYのための設計・解析・製作スタジオ",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p engine/tsconfig.json",
    "build:artifact": "npm run build && node scripts/artifact.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "check": "tsc --noEmit && tsc --noEmit -p engine/tsconfig.json && vitest run && node scripts/check-licenses.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2"
  },
  "private": true,
  "type": "module"
}
