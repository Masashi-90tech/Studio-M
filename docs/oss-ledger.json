  "policy": {
    "project_license": "MIT",
    "bundle_allowed": [
      "MIT",
      "ISC",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "Apache-2.0",
      "0BSD",
      "Unlicense",
      "Zlib",
      "CC0-1.0",
      "MIT/X11",
      "BlueOak-1.0.0",
      "Python-2.0"
    ],
    "bundle_conditional": [
      "LGPL-2.1",
      "LGPL-2.1-or-later",
      "LGPL-3.0",
      "MPL-2.0"
    ],
    "bundle_forbidden": [
      "GPL-2.0",
      "GPL-2.0-or-later",
      "GPL-3.0",
      "GPL-3.0-or-later",
      "AGPL-3.0",
      "AGPL-3.0-or-later",
      "SSPL-1.0"
    ],
    "rule": "forbidden のものは Studio M に組み込まず、別プロセス・ファイル連携でだけ使う。conditional は動的リンクや差し替え可能な形など条件を満たす場合に限り組み込む。デュアルライセンスは許可側を選んで記録する"
  },
  "usage_kinds": {
    "bundled": "Studio M の配布物に含まれる（ブラウザのバンドルなど）",
    "dev": "開発・ビルド時だけ使い、配布物に含まれない",
    "separate-process": "別プロセスとして呼び出す。配布物には含めない",
    "file-format": "ファイル形式だけでつながる（相手のソフトは利用者が別に入れる）",
    "planned": "採用予定。組み込む前に再調査する",
    "installed": "node_modules には入るが、配布物には含まれない（Node.js 実行時だけ使う依存など）。shipped: false で示す",
    "reference": "参考にしただけ。コードは使っていない"
  },
